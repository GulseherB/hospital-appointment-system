# Bu dosyayı .env adıyla kopyalayın ve değerleri değiştirin. .env sürüm kontrolüne eklenmez.
# Aşağıdaki şifreler yalnızca örnektir.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hospital_app
DB_PASSWORD=Example_Pass_123
DB_NAME=hospital_db

HTTP_ADDR=:8080
# En az 32 karakterlik rastgele bir değer kullanın.
JWT_SECRET=example-secret-change-me-at-least-32-chars

SUPER_ADMIN_EMAIL=superadmin@hospital.local
SUPER_ADMIN_PASSWORD=Admin_Example_123

# Demo hesaplarının ortak şifresi (go run ./cmd/seed -demo)
DEMO_PASSWORD=Demo_Example_123
